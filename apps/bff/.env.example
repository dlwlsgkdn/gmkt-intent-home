# BFF 환경변수 — 이 파일을 .env로 복사해 채운다 (.env는 커밋되지 않는다)
#   cp apps/bff/.env.example apps/bff/.env
#   node --env-file=apps/bff/.env apps/bff/dist/main.js

# ── 생성(Claude) ────────────────────────────────────────────────
# 없으면 설문·계획 생성이 llm_not_configured로 실패 안내된다
ANTHROPIC_API_KEY=

# ── core (쓰레드 저장·설정 KV) ──────────────────────────────────
CORE_URL=http://localhost:8790
CORE_SERVICE_TOKEN=

# ── 가상 메이크업 정밀 렌더 (이미지 편집) ──────────────────────
# Anthropic API에는 이미지 생성·편집이 없어 이 한 가지만 다른 프로바이더를 쓴다.
# 비워 두면 정밀 렌더 버튼이 image_not_configured로 응답하고, 화면은 기기 안에서 만든
# 랜드마크 합성을 그대로 유지한다 (체험은 깨지지 않는다).
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_IMAGE_MODEL=gpt-image-2

# ── 프록시 인증 ────────────────────────────────────────────────
# 설정하면 스튜디오 엣지 미들웨어가 주입하는 토큰과 일치해야 한다 (직접 호출은 401)
BFF_SERVICE_TOKEN=

# ── 선택 ───────────────────────────────────────────────────────
# LANGGRAPH_DATABASE_URL=        # 없으면 메모리 체크포인터
# ALLOWED_ORIGINS=               # CORS 화이트리스트
# PORT=8788
