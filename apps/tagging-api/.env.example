# 사내망에서만 닿는다. 값은 external-item-collector/.env 와 같다.
MONGO_URI=
MONGO_DB=eevee
MONGO_COLL=products
# 사전(taxonomy) 원천은 Mongo(<MONGO_DB>.<TAXONOMY_COLLECTION>, _id=TAXONOMY_DOC_ID)다.
TAXONOMY_COLLECTION=taxonomy
TAXONOMY_DOC_ID=current
# Python 저장소의 taxonomy.json 절대경로 — 이제는 Mongo가 안 닿을 때만 쓰는 폴백 경로다
TAXONOMY_PATH=/Users/minoh/oliveyoung-collector-poc/taxonomy.json
PORT=8790
# 바인딩 주소: 기본값 127.0.0.1(루프백, 같은 기계만 접근 가능). 사내 서버 배포 시에만 0.0.0.0으로 설정하되, 반드시 앞단에 인증(사내 SSO 프록시 등)을 둘 것.
# HOST=0.0.0.0
# 운영 배치 시에만: 스튜디오 빌드 산출물을 같은 오리진에서 서빙한다
# STUDIO_DIST=/srv/ddak/apps/studio/dist
