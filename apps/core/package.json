{
  "name": "ddak-core",
  "version": "0.1.0",
  "private": true,
  "description": "DDAK backend core — 쓰레드 저장·조회 (NestJS. 저장소는 배포 설정이 고른다: Neon Postgres/Drizzle 또는 사내 MongoDB — src/db/store.ts)",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "test": "npm run build && node --test test/*.test.mjs",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "seed:catalog": "node scripts/seed-catalog.mjs",
    "seed:catalog:neon": "node scripts/seed-catalog-neon.mjs"
  },
  "dependencies": {
    "@ddak/schema": "*",
    "@neondatabase/serverless": "^0.10.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/swagger": "^11.0.0",
    "drizzle-orm": "^0.45.2",
    "mongodb": "^6.10.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/node": "^22.10.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.7.2"
  }
}
