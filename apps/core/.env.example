# 저장소 선택 — neon | mongo. 비우면 MONGO_URI → mongo, DATABASE_URL → neon 로 자동 판정(둘 다 있으면 꼭 명시).
# github.com/Vercel 배포 = neon, 사내 퓨전(eevee-labatory) = mongo. 규칙은 src/db/store.ts, healthz 의 store 필드로 확인.
CORE_STORE=

# [neon] Neon Postgres 접속 문자열 (풀드 엔드포인트 권장). Vercel 에선 Neon 통합이 주입한다 — 로컬은 `vercel env pull`(.env.local).
DATABASE_URL=

# [mongo] 사내 MongoDB 접속 문자열 + 컬렉션이 담기는 DB 이름 (apps/tagging-api 와 같은 값, 기본 eevee)
MONGO_URI=
MONGO_DB=eevee

# 어느 쪽도 없으면 부팅은 되고 DB 를 쓰는 라우트만 503 (healthz 는 그대로 200).

# BFF → core 인증 토큰. 없으면 로컬 개발에선 통과, 프로덕션(NODE_ENV=production)에선 전부 거부.
CORE_SERVICE_TOKEN=

# 스노우플레이크 워커 id (0~1023, 선택). 비우면 인스턴스(콜드스타트)마다 무작위 배정.
SNOWFLAKE_WORKER_ID=

# 로컬 포트 (기본 8790)
PORT=8790
