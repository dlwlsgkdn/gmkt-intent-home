# 사내 MongoDB 접속 문자열. 없으면 부팅은 되고 DB 라우트만 503(healthz는 그대로 200).
MONGO_URI=

# 컬렉션이 담기는 DB 이름 — apps/tagging-api와 같은 값을 쓴다 (기본 eevee)
MONGO_DB=eevee

# BFF → core 인증 토큰. 없으면 로컬 개발에선 통과, 프로덕션(NODE_ENV=production)에선 전부 거부.
CORE_SERVICE_TOKEN=

# 스노우플레이크 워커 id (0~1023, 선택). 비우면 인스턴스(콜드스타트)마다 무작위 배정.
SNOWFLAKE_WORKER_ID=

# 로컬 포트 (기본 8790)
PORT=8790
